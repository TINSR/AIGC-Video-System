DATABASE_URL="mysql://root:{YOUR_PASSWORD}@localhost:3306/creative_video?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
PORT=3001
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
NODE_ENV="development"

# FFmpeg 路径（可选，默认从 PATH 查找）
# Windows 示例：FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
# FFMPEG_PATH=""

# Seedance / Volcengine Ark video generation (optional)
# Leave SEEDANCE_API_KEY empty to use FFmpeg fallback.
SEEDANCE_API_KEY=""
SEEDANCE_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
SEEDANCE_MODEL_ID="doubao-seedance-1-5-pro-251215"
SEEDANCE_GENERATE_AUDIO="false"
SEEDANCE_POLL_INTERVAL_MS="5000"
SEEDANCE_POLL_TIMEOUT_MS="900000"
SEEDANCE_SCENE_POLL_TIMEOUT_MS="600000"
# Base64 first_frame from local /uploads - debug only; production should use material.publicUrl
SEEDANCE_ALLOW_BASE64_DEBUG="false"

# Production: set false to fail when Seedance is unavailable (no FFmpeg fallback)
ALLOW_FFMPEG_FALLBACK="true"

# S3-compatible object storage (optional - unconfigured => cloudStatus local_only)
# Use an endpoint verified for S3-compatible AWS4 signing. Native TOS endpoints require TOS4 signing.
# OBJECT_STORAGE_PROVIDER="tos"
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION="cn-beijing"
# OBJECT_STORAGE_BUCKET="your-bucket"
# OBJECT_STORAGE_ACCESS_KEY=""
# OBJECT_STORAGE_SECRET_KEY=""
# OBJECT_STORAGE_PUBLIC_BASE_URL="https://your-bucket.tos-cn-beijing.volces.com"
# OBJECT_STORAGE_UPLOAD_TIMEOUT_MS="30000"

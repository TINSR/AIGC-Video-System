DATABASE_URL="mysql://root:{YOUR_PASSWORD}@localhost:3306/creative_video?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
PORT=3001
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./outputs"
NODE_ENV="development"

# Real LLM creative-plan generation (optional)
# Xiaomi MiMo multimodal example: provider=xiaomi-mimo, baseUrl=https://api.xiaomimimo.com/v1, model=mimo-v2.5
# REAL_LLM_PROVIDER="xiaomi-mimo"
# REAL_LLM_API_KEY=""
# REAL_LLM_BASE_URL="https://api.xiaomimimo.com/v1"
# REAL_LLM_MODEL="mimo-v2.5"
# REAL_LLM_TIMEOUT_MS="60000"
# REAL_LLM_MAX_TOKENS="4096"
# REAL_LLM_MAX_IMAGES="3"
# Local /uploads images are sent to the configured external LLM only when explicitly enabled.
# REAL_LLM_ALLOW_LOCAL_BASE64_IMAGES="false"
# REAL_LLM_MAX_LOCAL_IMAGE_BYTES="10485760"
# Volcengine Doubao multimodal example: provider=volcengine-doubao, baseUrl=https://ark.cn-beijing.volces.com/api/v3
# Set REAL_LLM_MODEL to the Ark Endpoint ID linked to a Doubao Seed 2.0 multimodal model.
# REAL_LLM_REASONING_EFFORT="minimal"

# FFmpeg 路径（可选，默认从 PATH 查找）
# Windows 示例：FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
# FFMPEG_PATH=""

# Seedance / Volcengine Ark video generation (optional)
# Leave SEEDANCE_API_KEY empty to use FFmpeg fallback.
SEEDANCE_API_KEY=""
SEEDANCE_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
SEEDANCE_MODEL_ID="doubao-seedance-1-5-pro-251215"
# Set to "2.0" only when the configured endpoint uses Seedance 2.0.
# SEEDANCE_MODEL_VERSION="1.5"
SEEDANCE_GENERATE_AUDIO="false"
SEEDANCE_POLL_INTERVAL_MS="5000"
SEEDANCE_POLL_TIMEOUT_MS="900000"
SEEDANCE_SCENE_POLL_TIMEOUT_MS="600000"
# Base64 first_frame from local /uploads - debug only; production should use material.publicUrl
SEEDANCE_ALLOW_BASE64_DEBUG="false"

# Reference video analysis (Day12 — optional)
# REFERENCE_VIDEO_ANALYSIS_API_KEY=""
# REFERENCE_VIDEO_ANALYSIS_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# REFERENCE_VIDEO_ANALYSIS_MODEL=""
# REFERENCE_VIDEO_ANALYSIS_TIMEOUT_MS="120000"
# Enable only for explicit local demos. Production should fail clearly without a configured model.
REFERENCE_VIDEO_ANALYSIS_ALLOW_MOCK="false"

# Production: set false to fail when Seedance is unavailable (no FFmpeg fallback)
ALLOW_FFMPEG_FALLBACK="true"

# Xiaomi MiMo TTS (optional — for AI voiceover in smart clip editing)
# MIMO_API_KEY=""
# Keys beginning with tp- use https://token-plan-cn.xiaomimimo.com/v1 automatically.
# Set MIMO_TTS_BASE_URL only when overriding the endpoint explicitly.
# MIMO_TTS_BASE_URL="https://api.xiaomimimo.com/v1"
# MIMO_TTS_MODEL="mimo-v2.5-tts"
# TTS_VOICE="冰糖"
# MIMO_TTS_STYLE_PROMPT="使用自然、亲切、有活力的中文电商短视频口播风格，语速稍快，商品卖点适当重读。"
# MIMO_TTS_TIMEOUT_MS="30000"
# TTS_MAX_TEXT_LENGTH="500"

# Aliyun OSS (Day11 — preferred when OBJECT_STORAGE_PROVIDER=aliyun_oss)
# OBJECT_STORAGE_PROVIDER="aliyun_oss"
# ALIYUN_OSS_REGION="oss-cn-hangzhou"
# ALIYUN_OSS_BUCKET="your-bucket"
# ALIYUN_OSS_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
# ALIYUN_OSS_ACCESS_KEY_ID=""
# ALIYUN_OSS_ACCESS_KEY_SECRET=""
# ALIYUN_OSS_PUBLIC_BASE_URL="https://your-bucket.oss-cn-hangzhou.aliyuncs.com"

# S3-compatible object storage (optional - unconfigured => cloudStatus local_only)
# Use an endpoint verified for S3-compatible AWS4 signing. Native TOS endpoints require TOS4 signing.
# OBJECT_STORAGE_PROVIDER="tos"
# OBJECT_STORAGE_ENDPOINT=""
# OBJECT_STORAGE_REGION="cn-beijing"
# OBJECT_STORAGE_BUCKET="your-bucket"
# OBJECT_STORAGE_ACCESS_KEY=""
# OBJECT_STORAGE_SECRET_KEY=""
# OBJECT_STORAGE_PUBLIC_BASE_URL="https://your-bucket.tos-cn-beijing.volces.com"
# OBJECT_STORAGE_UPLOAD_TIMEOUT_MS="30000"
